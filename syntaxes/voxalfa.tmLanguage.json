{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Voxalfa",
  "scopeName": "source.voxalfa",
  "fileTypes": ["va", "voxalfa"],
  "patterns": [
    { "include": "#directives" },
    { "include": "#comments" },
    { "include": "#delimiters" },
    { "include": "#metadata-and-parameters" },
    { "include": "#solfa-lines" },
    { "include": "#lyric-lines" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.voxalfa",
          "match": ";.*$"
        }
      ]
    },
    "delimiters": {
      "patterns": [
        {
          "name": "keyword.operator.header-delimiter.voxalfa",
          "match": "^---$"
        },
        {
          "name": "keyword.operator.section-delimiter.voxalfa",
          "match": "^(==|--|<<|\\+\\+)$"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "meta.directive.voxalfa",
          "match": "^\\s*(;;)(@)([a-zA-Z][a-zA-Z_-]*)\\s+(.*)$",
          "captures": {
            "1": { "name": "punctuation.definition.directive.voxalfa" },
            "2": { "name": "keyword.control.directive.voxalfa" },
            "3": { "name": "entity.name.function.directive.voxalfa" },
            "4": { "name": "string.unquoted.directive.voxalfa" }
          }
        }
      ]
    },
    "metadata-and-parameters": {
      "patterns": [
        {
          "name": "meta.line.metadata.voxalfa",
          "begin": "^\\[([#$\\^])\\]",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.tag.voxalfa" },
            "1": { "name": "keyword.other.line-type.voxalfa" }
          },
          "end": "$",
          "patterns": [
            { "include": "#comments" },
            { "include": "#parameter-assignment" },
            {
              "name": "punctuation.separator.pipe.voxalfa",
              "match": "\\|"
            }
          ]
        }
      ]
    },
    "parameter-assignment": {
      "patterns": [
        {
          "name": "meta.assignment.voxalfa",
          "begin": "([a-zA-Z][a-zA-Z_-]*)\\s*(=)",
          "beginCaptures": {
            "1": { "name": "variable.other.property.voxalfa" },
            "2": { "name": "keyword.operator.assignment.voxalfa" }
          },
          "end": "(?=\\||$|;|})",
          "patterns": [{ "include": "#values" }]
        }
      ]
    },
    "values": {
      "patterns": [
        {
          "name": "string.quoted.double.voxalfa",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.voxalfa",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "constant.language.boolean.voxalfa",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.numeric.float.voxalfa",
          "match": "\\b\\d*\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.voxalfa",
          "match": "\\b\\d+\\b"
        },
        {
          "name": "meta.delimited-value.voxalfa",
          "begin": "\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.bracket.curly.voxalfa" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.bracket.curly.voxalfa" }
          },
          "patterns": [
            { "include": "#values" },
            {
              "name": "punctuation.separator.comma.voxalfa",
              "match": ","
            },
            {
              "name": "keyword.operator.range.voxalfa",
              "match": ":|\\.\\."
            }
          ]
        },
        {
          "name": "variable.other.builtin.voxalfa",
          "match": "\\b[a-zA-Z#]+\\b"
        }
      ]
    },
    "solfa-lines": {
      "patterns": [
        {
          "name": "meta.line.solfa.voxalfa",
          "begin": "^\\[([a-zA-Z][a-zA-Z_-]*)\\]",
          "beginCaptures": {
            "0": { "name": "punctuation.bracket.square.voxalfa" },
            "1": { "name": "entity.name.type.voice.voxalfa" }
          },
          "end": "\\|\\||$",
          "endCaptures": {
            "0": { "name": "punctuation.section.solfa-end.voxalfa" }
          },
          "patterns": [
            { "include": "#comments" },
            {
              "name": "keyword.operator.accent.strong.voxalfa",
              "match": "\\|"
            },
            {
              "name": "keyword.operator.accent.medium.voxalfa",
              "match": "!"
            },
            {
              "name": "keyword.operator.accent.weak.voxalfa",
              "match": ":"
            },
            {
              "name": "keyword.operator.division.half.voxalfa",
              "match": "\\."
            },
            {
              "name": "keyword.operator.division.quarter.voxalfa",
              "match": ","
            },
            {
              "name": "punctuation.bracket.underline.voxalfa",
              "match": "`"
            },
            {
              "name": "constant.numeric.prolonged.voxalfa",
              "match": "-"
            },
            {
              "name": "meta.note.voxalfa",
              "match": "([drmfslt])([ai])?([+-]\\d)?",
              "captures": {
                "1": { "name": "constant.other.symbol.note.base.voxalfa" },
                "2": { "name": "keyword.operator.type.note.variation.voxalfa" },
                "3": { "name": "constant.numeric.octave.voxalfa" }
              }
            }
          ]
        }
      ]
    },
    "lyric-lines": {
      "patterns": [
        {
          "name": "meta.line.lyric.voxalfa",
          "begin": "^\\[(\\d+)\\]",
          "beginCaptures": {
            "0": { "name": "punctuation.bracket.square.voxalfa" },
            "1": { "name": "constant.numeric.integer.verse.voxalfa" }
          },
          "end": "$",
          "patterns": [
            { "include": "#comments" },
            {
              "name": "keyword.operator.anchor.voxalfa",
              "match": "@@"
            },
            {
              "name": "meta.lyric.span.voxalfa",
              "match": "(@)(\\d+)",
              "captures": {
                "1": { "name": "keyword.operator.span.voxalfa" },
                "2": { "name": "constant.numeric.integer.voxalfa" }
              }
            },
            {
              "name": "constant.character.special.voxalfa",
              "match": "&(bls|tld|btk|lch|rch|sls|lpr|rpr|atr|amp|scl|dot)"
            },
            {
              "name": "constant.language.placeholder.voxalfa",
              "match": "~"
            },
            {
              "name": "keyword.operator.lyric-concat.voxalfa",
              "match": "_+"
            },
            {
              "name": "keyword.operator.lyric-newline.voxalfa",
              "match": "\\\\+"
            },
            {
              "name": "punctuation.bracket.group.voxalfa",
              "match": "[()`]"
            }
          ]
        }
      ]
    }
  }
}
