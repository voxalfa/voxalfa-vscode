{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Voxalfa",
  "scopeName": "source.voxalfa",
  "fileTypes": ["vfa"],
  "patterns": [
    { "include": "#directives" },
    { "include": "#comments" },
    { "include": "#delimiters" },
    { "include": "#metadata-and-parameters" },
    { "include": "#solfa-lines" },
    { "include": "#lyric-lines" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.voxalfa",
          "match": ";.*$"
        }
      ]
    },
    "delimiters": {
      "patterns": [
        {
          "match": "^[ \\t]*(---)(?=[ \\t]*(?:;|$))",
          "captures": {
            "1": { "name": "keyword.operator.header-delimiter.voxalfa" }
          }
        },
        {
          "match": "^[ \\t]*(==)(?=[ \\t]*(?:;|$))",
          "captures": {
            "1": { "name": "keyword.operator.section-major-delimiter.voxalfa" }
          }
        },
        {
          "match": "^[ \\t]*(<<)(?=[ \\t]*(?:;|$))",
          "captures": {
            "1": { "name": "keyword.operator.section-merge-delimiter.voxalfa" }
          }
        },
        {
          "match": "^[ \\t]*(--)(?=[ \\t]*(?:;|$))",
          "captures": {
            "1": { "name": "keyword.operator.section-split-delimiter.voxalfa" }
          }
        },
        {
          "match": "^[ \\t]*(\\+\\+)(?=[ \\t]*(?:;|$))",
          "captures": {
            "1": { "name": "keyword.operator.sub-section-delimiter.voxalfa" }
          }
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "meta.directive.voxalfa",
          "begin": "^[ \\t]*(;;)[ \\t]*(@)[ \\t]*([a-zA-Z][a-zA-Z_-]*)(?=[ \\t]|$)",
          "beginCaptures": {
            "1": { "name": "comment.line.semicolon.voxalfa" },
            "2": { "name": "keyword.control.directive.voxalfa" },
            "3": { "name": "keyword.control.directive.voxalfa" }
          },
          "end": "$",
          "patterns": [
            { "include": "#comments" },
            { "match": "[ \\t]+" },
            { "include": "#parameter-assignment" },
            {
              "name": "punctuation.separator.pipe.voxalfa",
              "match": "\\|"
            },
            {
              "name": "comment.line.directive.voxalfa",
              "match": "[^;\\n]+"
            }
          ]
        }
      ]
    },
    "assignment-line-body": {
      "patterns": [
        { "include": "#comments" },
        {
          "name": "punctuation.separator.pipe.voxalfa",
          "match": "\\|"
        },
        { "include": "#parameter-assignment" }
      ]
    },
    "metadata-and-parameters": {
      "patterns": [
        {
          "name": "meta.line.metadata.voxalfa",
          "begin": "^[ \\t]*(\\[)[ \\t]*(#)[ \\t]*(\\])",
          "beginCaptures": {
            "1": { "name": "punctuation.bracket.square.voxalfa" },
            "2": { "name": "keyword.other.line-type.voxalfa" },
            "3": { "name": "punctuation.bracket.square.voxalfa" }
          },
          "end": "$",
          "patterns": [{ "include": "#assignment-line-body" }]
        },
        {
          "name": "meta.line.parameter.voxalfa",
          "begin": "^[ \\t]*(\\[)[ \\t]*(\\$)[ \\t]*(\\])",
          "beginCaptures": {
            "1": { "name": "punctuation.bracket.square.voxalfa" },
            "2": { "name": "keyword.other.line-type.voxalfa" },
            "3": { "name": "punctuation.bracket.square.voxalfa" }
          },
          "end": "$",
          "patterns": [{ "include": "#assignment-line-body" }]
        }
      ]
    },
    "parameter-assignment": {
      "patterns": [
        {
          "name": "meta.assignment.voxalfa",
          "begin": "([a-zA-Z][a-zA-Z_-]*)[ \\t]*(=)",
          "beginCaptures": {
            "1": { "name": "variable.other.property.voxalfa" },
            "2": { "name": "keyword.operator.assignment.voxalfa" }
          },
          "end": "(?=[ \\t]*(?:\\||;|$|\\}))",
          "patterns": [
            { "match": "[ \\t]+" },
            { "include": "#assignment-values" }
          ]
        }
      ]
    },
    "assignment-values": {
      "patterns": [
        {
          "name": "string.quoted.double.voxalfa",
          "match": "\"[^\"\\n]*\""
        },
        { "include": "#delimited-value" }
      ]
    },
    "delimited-value": {
      "patterns": [
        {
          "name": "meta.delimited-value.voxalfa",
          "begin": "\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.bracket.curly.voxalfa" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.bracket.curly.voxalfa" }
          },
          "patterns": [
            { "include": "#values" },
            {
              "name": "punctuation.separator.comma.voxalfa",
              "match": ","
            },
            {
              "name": "keyword.operator.range.voxalfa",
              "match": "\\.\\.|:"
            }
          ]
        }
      ]
    },
    "values": {
      "patterns": [
        {
          "name": "string.quoted.double.voxalfa",
          "match": "\"[^\"\\n]*\""
        },
        {
          "name": "constant.language.boolean.voxalfa",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.numeric.float.voxalfa",
          "match": "\\d*\\.\\d+"
        },
        {
          "name": "constant.numeric.integer.voxalfa",
          "match": "\\d+"
        },
        {
          "name": "variable.other.builtin.voxalfa",
          "match": "[a-zA-Z#]+"
        }
      ]
    },
    "solfa-lines": {
      "patterns": [
        {
          "name": "meta.line.solfa.voxalfa",
          "begin": "^[ \\t]*(\\[)[ \\t]*([a-zA-Z][a-zA-Z_-]*)[ \\t]*(\\])",
          "beginCaptures": {
            "1": { "name": "punctuation.bracket.square.voxalfa" },
            "2": { "name": "entity.name.type.voice.voxalfa" },
            "3": { "name": "punctuation.bracket.square.voxalfa" }
          },
          "end": "\\|\\||$",
          "endCaptures": {
            "0": { "name": "punctuation.section.solfa-end.voxalfa" }
          },
          "patterns": [
            { "include": "#comments" },
            {
              "name": "keyword.operator.accent.strong.voxalfa",
              "match": "\\|"
            },
            {
              "name": "keyword.operator.accent.medium.voxalfa",
              "match": "!"
            },
            {
              "name": "keyword.operator.accent.weak.voxalfa",
              "match": ":"
            },
            {
              "name": "keyword.operator.division.half.voxalfa",
              "match": "\\."
            },
            {
              "name": "keyword.operator.division.quarter.voxalfa",
              "match": ","
            },
            {
              "name": "punctuation.bracket.underline.voxalfa",
              "match": "`"
            },
            {
              "name": "constant.language.prolonged.voxalfa",
              "match": "-"
            },
            {
              "name": "meta.note.voxalfa",
              "match": "([drmfslt])([ai])?([+-]\\d)?",
              "captures": {
                "1": { "name": "constant.other.symbol.note.base.voxalfa" },
                "2": { "name": "keyword.operator.type.note.variation.voxalfa" },
                "3": { "name": "constant.numeric.octave.voxalfa" }
              }
            }
          ]
        }
      ]
    },
    "lyric-lines": {
      "patterns": [
        {
          "name": "meta.line.lyric.voxalfa",
          "begin": "^[ \\t]*(\\[)[ \\t]*(\\d+)[ \\t]*(\\])",
          "beginCaptures": {
            "1": { "name": "punctuation.bracket.square.voxalfa" },
            "2": { "name": "constant.numeric.integer.verse.voxalfa" },
            "3": { "name": "punctuation.bracket.square.voxalfa" }
          },
          "end": "$",
          "patterns": [{ "include": "#lyric-line-body" }]
        },
        {
          "name": "meta.line.lyric.voxalfa",
          "begin": "^[ \\t]*(\\[)[ \\t]*(\\*)[ \\t]*(\\])",
          "beginCaptures": {
            "1": { "name": "punctuation.bracket.square.voxalfa" },
            "2": { "name": "keyword.operator.verse-wildcard.voxalfa" },
            "3": { "name": "punctuation.bracket.square.voxalfa" }
          },
          "end": "$",
          "patterns": [{ "include": "#lyric-line-body" }]
        }
      ]
    },
    "lyric-line-body": {
      "patterns": [
        { "include": "#comments" },
        {
          "name": "keyword.operator.anchor.voxalfa",
          "match": "@@"
        },
        {
          "name": "meta.lyric.span.voxalfa",
          "match": "(@)(\\d+)",
          "captures": {
            "1": { "name": "keyword.operator.span.voxalfa" },
            "2": { "name": "constant.numeric.integer.voxalfa" }
          }
        },
        {
          "name": "constant.character.special.voxalfa",
          "match": "&(bls|tld|btk|lpr|rpr|atr|amp|scl)"
        },
        {
          "name": "constant.language.placeholder.voxalfa",
          "match": "~"
        },
        {
          "name": "keyword.operator.lyric-concat.voxalfa",
          "match": "_+"
        },
        {
          "name": "keyword.operator.lyric-newline.voxalfa",
          "match": "\\\\+"
        },
        {
          "name": "punctuation.bracket.group.voxalfa",
          "match": "[()`]"
        }
      ]
    }
  }
}
